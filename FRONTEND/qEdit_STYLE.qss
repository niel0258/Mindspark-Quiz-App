/* Window */
#root {
    background: white;
}

/* Header */
#header {
    background: #651416;
}
#quizName {
    font-size: 26px;
    font-weight: bold;
    color: white;
}
#subjectName {
    font-size: 15px;
    color: white;
}

/* Question card */
#card {
    background: #d9d9d9;
    border-radius: 28px;
}

/* Top bar of the card: type combo box + points */
#cardBar {
    background: #651416;
    border-radius: 28px;
}
#cardBar QComboBox {
    background: transparent;
    color: white;
    border: none;
    font-size: 18px;
    font-weight: bold;
    padding: 4px 8px;
}
#cardBar QComboBox::drop-down {
    border: none;
    width: 24px;
}
#cardBar QComboBox QAbstractItemView {
    background: white;
    color: black;
    selection-background-color: #651416;
    selection-color: white;
    font-size: 14px;
    font-weight: normal;
}
#cardBar QSpinBox {
    background: transparent;
    color: white;
    border: none;
    font-size: 14px;
}

/* Question text and option fields */
#questionEdit {
    background: transparent;
    border: none;
    font-size: 28px;
    font-weight: bold;
}
#option {
    background: white;
    color: black;
    border: none;
    border-radius: 15px;
    padding: 9px 20px;
    font-size: 14px;
}
#optionEdit {
    background: white;
    border: none;
    border-radius: 13px;
    padding: 6px 14px;
    font-size: 14px;
}

/* Radio buttons: maroon ring, filled dot when checked */
QRadioButton::indicator {
    width: 26px;
    height: 26px;
    border-radius: 15px;
    border: 2px solid #651416;
    background: white;
}
QRadioButton::indicator:checked {
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
                                stop: 0 #651416, stop: 0.5 #651416,
                                stop: 0.55 white, stop: 1 white);
}

/* Quiz Navi panel */
#navi {
    background: #ebebeb;
    border-radius: 28px;
}
#naviTitle {
    background: #651416;
    color: white;
    border-radius: 26px;
    font-size: 14px;
    font-weight: bold;
    min-height: 52px;
    max-height: 52px;
}
#navi QPushButton#navItem {
    background: transparent;
    color: black;
    border: none;
    font-size: 15px;
    text-align: left;
    padding: 4px;
}
#navi QPushButton#navItem:checked {
    font-weight: bold;
}

/* Quiz Navi scroll area */
#naviScroll, #naviHolder {
    background: transparent;
    border: none;
}
#naviScroll QScrollBar:vertical {
    width: 8px;
    background: transparent;
    margin: 0 2px;
}
#naviScroll QScrollBar::handle:vertical {
    background: #b5b5b5;
    border-radius: 4px;
    min-height: 24px;
}
#naviScroll QScrollBar::add-line:vertical,
#naviScroll QScrollBar::sub-line:vertical {
    height: 0;
}

/* Buttons */
QPushButton#pill {
    background: #651416;
    color: white;
    border: none;
    border-radius: 15px;
    padding: 9px 20px;
    font-size: 14px;
}
QPushButton#pill:disabled {
    background: #9b7a7b;
}
QPushButton#addOption {
    background: white;
    color: black;
    border: none;
    border-radius: 15px;
    padding: 9px 20px;
    font-size: 14px;
}
QPushButton#round {
    background: #ff2a2a;
    color: white;
    border: none;
    border-radius: 17px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
}
